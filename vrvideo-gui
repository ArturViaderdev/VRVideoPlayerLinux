            keyring_delete(self.deovr["login"])
        self.deovr.update({"password": "", "ok": False})
        self.cfg["deovr_remember"] = False
        self.dv_remember.set(False)
        self.dv_pw.delete(0, "end")
        self.save_cfg()
        self.deovr_load(False)

    def deovr_load(self, logging_in):
        site = self.dv_site.get().strip() or "https://deovr.com"
        if not re.match(r"^[a-z]+://", site):
            site = "https://" + site
        self.cfg["deovr_site"] = site
        self.dv_status.config(text=T("Conectando con ", "Connecting to ") + site + "…", foreground="#2a6")
        cmd = vrplay_cmd() + ["--deovr-list", site]
        env = self.child_env()
        self.dv_gen = getattr(self, "dv_gen", 0) + 1
        gen = self.dv_gen

        def work():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=120, env=env)
                data = json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None
                err = "" if data else ((r.stderr.strip().splitlines() or ["?"])[-1])
            except (OSError, ValueError, subprocess.SubprocessError) as ex:
                data, err = None, str(ex)
            self.q.put(("deovr", (gen, logging_in, data, err)))
        threading.Thread(target=work, daemon=True).start()

    def deovr_loaded(self, gen, logging_in, data, err):
        if not (self.deovr_win and self.deovr_win.winfo_exists()) or gen != self.dv_gen:
            return  # window closed, or an older request answering late
        if not data:
            self.deovr["ok"] = False
            self.dv_status.config(text=err, foreground="#c33")
            if logging_in and "contrasena" in err:
                self.deovr["password"] = ""
            return
        auth = data.get("authorized")
        if self.deovr.get("password"):
            self.deovr["ok"] = auth in (1, "1")
            if logging_in:
                if self.deovr["ok"]:
                    self.cfg["deovr_login"] = self.deovr["login"]
                    self.cfg["deovr_remember"] = bool(self.dv_remember.get())
                    if self.dv_remember.get() and not keyring_set(self.deovr["login"], self.deovr["password"]):
                        self.cfg["deovr_remember"] = False
                        messagebox.showwarning("DeoVR", T("No hay llavero del sistema: la contraseña no se guarda (solo vale hasta "
                                                          "cerrar la ventana). Instala python3-keyring o libsecret-tools.",
                                                          "No system keyring: the password is not saved (only until you "
                                                          "close the window). Install python3-keyring or libsecret-tools."),
                                               parent=self.deovr_win)
                    self.save_cfg()
                else:
                    messagebox.showwarning("DeoVR", T("La web no ha confirmado la sesión (puede que no admita iniciar "
                                                      "sesión desde reproductores).", "The site did not confirm the login "
                                                      "(it may not allow logging in from players)."), parent=self.deovr_win)
        self.dv_status.config(text=self.deovr_state_text(), foreground="#2a6")
        # prepare once: normalized titles for searching, labels, and the deduplicated "all" list
        seen, everything = set(), []
        for sc in data["scenes"]:
            for it in sc["list"]:
                n = int(it.get("length") or 0)
                it["_label"] = it["title"] + ("  (%d:%02d:%02d)" % (n // 3600, n // 60 % 60, n % 60) if n else "")
                it["_n"] = norm(it["title"])
                key = (it["url"], it["title"])
                if key not in seen:
                    seen.add(key)
                    everything.append(it)
        self.dv_all = everything
        self.dv_data = data
        names = ["%s (%d)" % (sc["name"] or T("Vídeos", "Videos"), len(sc["list"])) for sc in data["scenes"]]
        self.dv_scene.configure(values=names)
        if names and self.dv_scene.current() < 0:
            self.dv_scene.current(0)
        self.deovr_fill()

    def deovr_filter_later(self):
        """search while typing, without filtering on every key press"""
        if getattr(self, "dv_after", None):
            self.root.after_cancel(self.dv_after)
        self.dv_after = self.root.after(250, self.deovr_fill)

    def deovr_fill(self):
        self.dv_after = None
        self.dv_list.delete(0, "end")
        self.dv_shown = []
        if not self.dv_data:
            self.dv_count.config(text="")
            return
        words = norm(self.dv_search.get()).split()
        c = self.dv_scene.current()
        if c >= len(self.dv_data["scenes"]):
            c = -1
        src = self.dv_all if (c < 0 or (words and self.dv_everywhere.get())) else self.dv_data["scenes"][c]["list"]
        shown = [it for it in src if all(wd in it["_n"] for wd in words)] if words else list(src)
        self.dv_shown = shown
        if shown:
            self.dv_list.insert("end", *[it["_label"] for it in shown])
        total = len(src)
        self.dv_count.config(text=(T("%d vídeos", "%d videos") % total) if not words else
                             (T("%d de %d vídeos", "%d of %d videos") % (len(shown), total)))

    def deovr_item(self):
