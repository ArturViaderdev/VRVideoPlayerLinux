    def run_logged(self, cmd):
        self.append("$ " + " ".join(cmd) + "\n")

        def work():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=180)
                self.q.put(("line", r.stdout + r.stderr))
            except (OSError, subprocess.SubprocessError) as ex:
                self.q.put(("line", str(ex) + "\n"))
        threading.Thread(target=work, daemon=True).start()

    def describe(self, p):
        if p.lower().endswith(".iso"):
            return T("Imagen ISO de Blu-ray 3D", "3D Blu-ray ISO image")
        n = os.path.basename(p).upper()
        guess = ""
        if any(k in n for k in ("HSBS", "H-SBS", "HALF-SBS", "HALF.SBS")):
            guess = "Half SBS"
        elif any(k in n for k in ("HOU", "H-OU", "HTAB", "HALF-OU")):
            guess = T("Half arriba/abajo", "Half top/bottom")
        elif any(k in n for k in ("FSBS", "FULL-SBS")):
            guess = T("SBS completo", "Full SBS")
        toks = [t for t in re.split(r"[^A-Z0-9]+", n) if t]
        for t in toks:
            if t in ("180", "VR180", "360", "VR360") or t.startswith(("180X", "360X")):
                guess = "VR " + ("180°" if "180" in t else "360°")
        for t in toks:
            if guess.startswith("VR") and t in ("LR", "SBS", "3DH", "TB", "OU", "3DV", "MONO"):
                guess += " · " + t
        try:
            size = fmt_size(os.path.getsize(p))
        except OSError:
            size = ""
        return " · ".join(x for x in (T("Vídeo", "Video"), guess, size) if x)

    def show_folder(self, d, select=True, highlight=None):
        try:
            names = sorted(os.listdir(d), key=lambda s: s.lower())
        except OSError:
            return
        self.cur_folder = d
        self.cfg["last_folder"] = d
        self.folder_lbl.config(text=d)
        self.lst.delete(0, "end")
        self.items = []
        dirs, files = [], []
        for n in names:
            if n.startswith("."):
                continue
            full = os.path.join(d, n)
            if os.path.isdir(full):
                dirs.append(full)
            elif n.lower().endswith(VIDEO_EXT + (".iso",)):
                files.append(full)
        for full in dirs:
            bd = is_bluray(full)
            self.lst.insert("end", os.path.basename(full) + ("   [Blu-ray 3D]" if bd else "/"))
            self.items.append(full)
        for full in files:
            self.lst.insert("end", os.path.basename(full) + ("   [ISO]" if full.lower().endswith(".iso") else ""))
            self.items.append(full)
        if highlight:
            for i, it in enumerate(self.items):
                if os.path.normpath(it) == os.path.normpath(highlight):
                    self.lst.selection_set(i)
                    self.lst.see(i)
        if select and not highlight:
            nvid = len(files)
            self.kind.config(text=T("Carpeta: %d vídeo(s)", "Folder: %d video(s)") % nvid)

    def list_select(self, _e=None):
        sel = self.lst.curselection()
        if not sel:
            return
        p = self.items[sel[0]]
        self.path.set(p)
        if os.path.isdir(p) and is_bluray(p):
            self.kind.config(text=T("Blu-ray 3D (se reproduce el título principal en 3D)",
                                    "3D Blu-ray (the main title plays in 3D)"))
        elif os.path.isdir(p):
            self.kind.config(text=T("Carpeta (doble clic para entrar)", "Folder (double click to open)"))
        else:
            self.kind.config(text=self.describe(p))

    def folder_up(self):
        d = getattr(self, "cur_folder", None)
        if d:
            parent = os.path.dirname(os.path.normpath(d))
            if parent and parent != d:
                self.show_folder(parent)

    def play_folder(self):
        d = getattr(self, "cur_folder", None)
        if d:
            self.path.set(d)
            self.play()

    # ---- playing -------------------------------------------------------------------------------
    def play(self):
        p = self.path.get().strip()
        if not p:
            self.pick_file()
            p = self.path.get().strip()
            if not p:
                return
        # double click on a normal folder: open it instead of playing it
        sel = self.lst.curselection()
        if (os.path.isdir(p) and not is_bluray(p) and sel and self.items[sel[0]] == p
                and self.root.focus_get() == self.lst):
            self.show_folder(p)
            return
        if not (os.path.exists(p) or re.match(r"^[a-z]+://", p)):
            messagebox.showerror("VR Video Player", T("No existe:\n", "Not found:\n") + p)
            return
        if self.proc and self.proc.poll() is None:
            if not messagebox.askyesno("VR Video Player", T("Ya se está reproduciendo algo. ¿Pararlo y empezar este?",
                                                              "Something is already playing. Stop it and play this?")):
                return
            self.stop(wait=True)
        cmd = vrplay_cmd()
        pk = self.proj_key()
        if pk != "auto":
            cmd.append({"flat": "--flat", "180": "--180", "360": "--360", "fisheye": "--fisheye"}[pk])
        fk = self.fmt_key()
        if fk != "auto":
            cmd.append({"sbs": "--full", "hsbs": "--half", "tab": "--tab", "htab": "--htab", "mono": "--2d"}[fk])
        if self.swap.get():
            cmd.append("--swap")
        if self.rt_key() != "auto":
            cmd += ["--runtime", self.rt_key()]
        cmd.append("--vr-mode=" + self.mode_key())
        if re.match(r"^[a-z]+://", p):
            cmd += ["--quality", self.quality_key()] + self.deovr_flag(p)
        for ent, opt in ((self.screen, "--vr-screen="), (self.dist, "--vr-distance=")):
            v = ent.get().strip().replace(",", ".")
            if v:
                try:
                    float(v)
                    cmd.append(opt + v)
                except ValueError:
                    messagebox.showerror("VR Video Player", T("Número no válido: ", "Invalid number: ") + v)
                    return
        al = self.alang.get().strip()
        if al:
            cmd.append("--alang=" + al)
        st = self.start.get().strip()
        if st:
            cmd.append("--start=" + st)
        sub = self.sub.get().strip()
        if sub:
            cmd += ["--sub", sub]
        cmd.append(p)
        recent = [p] + [x for x in self.cfg.get("recent", []) if x != p]
        self.cfg["recent"] = recent[:15]
        self.path.configure(values=self.cfg["recent"])
        self.save_cfg()
        self.clear_log()
        self.append("$ " + " ".join(cmd[1:]) + "\n")
        kw = {}
        if WINDOWS:
            kw["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP
        else:
            kw["start_new_session"] = True
        try:
            self.proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                         text=True, bufsize=1, errors="replace", env=self.child_env(), **kw)
        except OSError as e:
            messagebox.showerror("VR Video Player", str(e))
            return
        threading.Thread(target=self.reader, args=(self.proc,), daemon=True).start()
        self.play_btn.config(state="disabled")
        self.stop_btn.config(state="normal")
        self.status.config(text=T("Arrancando… ponte el visor", "Starting… put the headset on"))

    def reader(self, proc):
        for line in proc.stdout:
            self.q.put(("line", line))
        proc.wait()
        self.q.put(("end", proc.returncode))

    def stop(self, wait=False):
        p = self.proc
        if not p or p.poll() is not None:
            return
        try:
            if WINDOWS:
                p.send_signal(signal.CTRL_BREAK_EVENT)
            else:
                os.killpg(p.pid, signal.SIGINT)  # vrvideo and vr-bd quit cleanly (ISO unmounted...)
        except OSError:
            pass
        deadline = time.time() + (6 if wait else 0)
        while wait and p.poll() is None and time.time() < deadline:
            time.sleep(0.1)
        if wait and p.poll() is None:
            try:
                if WINDOWS:
                    p.kill()
                else:
                    os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                pass

    def poll(self):
        try:
            while True:
                kind, val = self.q.get_nowait()
                if kind == "probe":
                    self.show_probe(*val)
                    continue
                if kind == "deovr":
                    self.deovr_loaded(*val)
                    continue
                if kind == "line":
                    s = val.rstrip("\n")
                    if re.match(r"^\s*(\(Paused\) |\(Buffering\) )?(AV|A|V):", s):
                        self.status.config(text=s.strip())
                    elif s.strip():
                        if "sesion VR iniciada" in s or "VR session started" in s:
                            self.status.config(text=T("Reproduciendo en el visor", "Playing in the headset"))
                        elif "esperando a que se conecte el visor" in s or "waiting for the headset" in s:
                            self.status.config(text=T("Esperando al visor (abre WiVRn en el visor)…",
                                                      "Waiting for the headset (open WiVRn in it)…"))
                        self.append(s + "\n")
                else:
                    self.play_btn.config(state="normal")
                    self.stop_btn.config(state="disabled")
                    self.status.config(text=(T("Terminado", "Finished") if val in (0, None, -2, 130)
                                             else T("Terminado con error (%s), mira el registro", "Ended with error (%s), see the log") % val))
        except queue.Empty:
            pass
        self.root.after(100, self.poll)

    def append(self, s):
        self.log.config(state="normal")
        self.log.insert("end", s)
        if int(self.log.index("end-1c").split(".")[0]) > 2000:
            self.log.delete("1.0", "500.0")
        self.log.see("end")
        self.log.config(state="disabled")

    def clear_log(self):
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")

    def on_close(self):
        self.save_cfg()
        if self.proc and self.proc.poll() is None:
            self.stop(wait=True)
        self.root.destroy()


