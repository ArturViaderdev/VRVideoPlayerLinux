    def load_cfg(self):
        try:
            with open(os.path.join(config_dir(), "gui.json")) as f:
                return json.load(f)
        except (OSError, ValueError):
            return {}

    def save_cfg(self):
        c = self.cfg
        c.update({"quality": self.quality_key(), "projection": self.proj_key(), "format": self.fmt_key(), "swap": self.swap.get(), "runtime": self.rt_key(), "mode": self.mode_key(),
                  "screen": self.screen.get().strip(), "distance": self.dist.get().strip(),
                  "alang": self.alang.get().strip(), "geometry": self.root.geometry()})
        try:
            os.makedirs(config_dir(), exist_ok=True)
            with open(os.path.join(config_dir(), "gui.json"), "w") as f:
                json.dump(c, f, indent=1)
        except OSError:
            pass

