def config_dir():
    if WINDOWS:
        return os.path.join(os.environ.get("APPDATA", os.path.expanduser("~")), "vrvideoplayer")
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "vrvideoplayer")


def is_bluray(path):
    if path.lower().endswith(".iso") and os.path.isfile(path):
        return True
    if os.path.isdir(path):
        if os.path.basename(os.path.normpath(path)).upper() == "BDMV":
            return os.path.isdir(os.path.join(path, "PLAYLIST"))
        return any(os.path.isdir(os.path.join(path, b, p)) for b in ("BDMV", "bdmv") for p in ("PLAYLIST", "playlist"))
    return False


KEYRING_SERVICE = "vrvideoplayer-deovr"


def keyring_get(user):
    try:
        import keyring
        return keyring.get_password(KEYRING_SERVICE, user)
    except Exception:
        pass
    if shutil.which("secret-tool"):
        try:
            r = subprocess.run(["secret-tool", "lookup", "service", KEYRING_SERVICE, "user", user],
                               capture_output=True, text=True, timeout=15)
            return r.stdout if r.returncode == 0 and r.stdout else None
        except (OSError, subprocess.SubprocessError):
            pass
    return None


def keyring_set(user, pw):
    """saves the password in the desktop keyring (never in a plain file); False if there is no keyring"""
    try:
        import keyring
        keyring.set_password(KEYRING_SERVICE, user, pw)
        return True
    except Exception:
        pass
    if shutil.which("secret-tool"):
        try:
            r = subprocess.run(["secret-tool", "store", "--label=VR Video Player (DeoVR)", "service", KEYRING_SERVICE,
                                "user", user], input=pw, text=True, capture_output=True, timeout=20)
            return r.returncode == 0
        except (OSError, subprocess.SubprocessError):
            pass
    return False


def keyring_delete(user):
    try:
        import keyring
        keyring.delete_password(KEYRING_SERVICE, user)
    except Exception:
        pass
    if shutil.which("secret-tool"):
        subprocess.run(["secret-tool", "clear", "service", KEYRING_SERVICE, "user", user], capture_output=True)


def norm(t):
    """lower case without accents, for searching ("Islandia" finds "islándia")"""
    t = unicodedata.normalize("NFKD", t.lower())
    return "".join(c for c in t if not unicodedata.combining(c))


def url_host(u):
    m = re.match(r"^[a-z]+://([^/:?#]+)", u.strip().replace("deovr://", "", 1), re.I)
    return m.group(1).lower() if m else ""


def vrplay_cmd():
    p = shutil.which("vr-play") or os.path.join(HERE, "vr-play")
    return [sys.executable, p]


def fmt_size(n):
    for u in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or u == "TB":
            return ("%.1f %s" % (n, u)) if u != "B" else "%d B" % n
        n /= 1024.0


