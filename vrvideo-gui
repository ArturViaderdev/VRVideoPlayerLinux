def _lang_es():
    for v in ("LANGUAGE", "LC_ALL", "LC_MESSAGES", "LANG"):
        l = os.environ.get(v)
        if l:
            return l[:2] in ("es", "ca")
    if WINDOWS:
        try:
            import locale
            return (locale.getdefaultlocale()[0] or "")[:2] in ("es", "ca")
        except Exception:
            pass
    return False


ES = _lang_es()


