    def deovr_login(self):
        user, pw = self.dv_user.get().strip(), self.dv_pw.get()
        if not user or not pw:
            messagebox.showerror("DeoVR", T("Escribe el usuario y la contraseña", "Enter user and password"), parent=self.deovr_win)
