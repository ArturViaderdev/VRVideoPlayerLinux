        self.root = root
        self.proc = None
        self.q = queue.Queue()
        self.items = []  # paths shown in the list
        self.cfg = self.load_cfg()
        root.title("VR Video Player")
        root.geometry(self.cfg.get("geometry", "900x760"))
        root.minsize(640, 480)
        try:
            ttk.Style().theme_use("clam")
        except tk.TclError:
            pass
        self.build()
        root.protocol("WM_DELETE_WINDOW", self.on_close)
        root.after(100, self.poll)
        self.deovr = {"login": self.cfg.get("deovr_login", ""), "password": "", "ok": False}
        if self.deovr["login"] and self.cfg.get("deovr_remember"):
            self.deovr["password"] = keyring_get(self.deovr["login"]) or ""
        self.deovr_win = None
        last = self.cfg.get("last_folder")
        if last and os.path.isdir(last):
            self.show_folder(last, select=False)

