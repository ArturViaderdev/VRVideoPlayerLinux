    @staticmethod
    def index(options, key):
        for i, (k, _) in enumerate(options):
            if k == key:
                return i
        return 0

    def fmt_key(self):
        return FORMATS[max(0, self.fmt.current())][0]

    def proj_key(self):
        return PROJECTIONS[max(0, self.proj.current())][0]

    def quality_key(self):
        return QUALITIES[max(0, self.quality.current())][0]

    def rt_key(self):
        return RUNTIMES[max(0, self.rt.current())][0]

    def mode_key(self):
        return MODES[max(0, self.mode.current())][0]

    # ---- choosing -------------------------------------------------------------------------------
    def start_dir(self):
        p = self.path.get().strip()
        if p and os.path.isdir(p):
            return p
        if p and os.path.isfile(p):
            return os.path.dirname(p)
        return self.cfg.get("last_folder") or os.path.expanduser("~")

    def pick_file(self):
        f = filedialog.askopenfilename(
            parent=self.root, initialdir=self.start_dir(), title=T("Elige un vídeo 3D o una ISO", "Choose a 3D video or an ISO"),
            filetypes=[(T("Vídeos e ISOs", "Videos and ISOs"), " ".join("*" + e for e in VIDEO_EXT + (".iso",))),
                       (T("Todos", "All"), "*")])
        if f:
            self.set_path(f)

    def pick_folder(self):
        d = filedialog.askdirectory(parent=self.root, initialdir=self.start_dir(),
                                    title=T("Elige una carpeta (vídeos o Blu-ray)", "Choose a folder (videos or Blu-ray)"))
        if d:
            self.set_path(d)

    def pick_sub(self):
        f = filedialog.askopenfilename(parent=self.root, initialdir=self.start_dir(),
                                       filetypes=[(T("Subtítulos", "Subtitles"), "*.srt *.ass *.ssa"), (T("Todos", "All"), "*")])
        if f:
            self.sub.delete(0, "end")
            self.sub.insert(0, f)

    def set_path(self, p):
        self.path.set(p)
        self.path_changed()

    def path_changed(self, only_url=False):
        p = self.path.get().strip()
        if re.match(r"^[a-z]+://", p):
            if p != getattr(self, "analyzed_url", None):
                self.analyze_url(p)
            return
        if only_url:
            return
        if os.path.isdir(p):
            if is_bluray(p):
                self.kind.config(text=T("Blu-ray 3D (se reproduce el título principal en 3D)",
                                        "3D Blu-ray (the main title plays in 3D)"))
                parent = os.path.dirname(os.path.normpath(p))
                if os.path.basename(os.path.normpath(p)).upper() == "BDMV":
                    parent = os.path.dirname(parent)
                self.show_folder(parent or p, select=False, highlight=os.path.normpath(p))
            else:
                self.show_folder(p)
        elif os.path.isfile(p):
            self.kind.config(text=self.describe(p))
            self.show_folder(os.path.dirname(p), select=False, highlight=p)
        else:
            self.kind.config(text="")

    # ---- online videos ---------------------------------------------------------------------------
    def pick_url(self):
        """small dialog for a YouTube (or any yt-dlp site) link; takes it from the clipboard if there is one"""
        d = tk.Toplevel(self.root)
        d.title(T("Abrir enlace web", "Open web link"))
        d.transient(self.root)
        d.resizable(True, False)
        ttk.Label(d, text=T("Enlace de YouTube u otra web (vídeo 3D o VR 180/360):",
                            "YouTube or other site link (3D or VR 180/360 video):")).pack(anchor="w", padx=10, pady=(10, 4))
        e = ttk.Entry(d, width=70)
        e.pack(fill="x", padx=10)
        try:
            clip = self.root.clipboard_get().strip()
            if re.match(r"^https?://", clip):
                e.insert(0, clip)
        except tk.TclError:
            pass
        e.focus_set()
        e.select_range(0, "end")
        res = {}

        def ok(play=False):
            u = e.get().strip()
            if not re.match(r"^[a-z]+://", u):
                if u and "." in u and " " not in u:
                    u = "https://" + u
                else:
                    messagebox.showerror("VR Video Player", T("No parece un enlace", "That is not a link"), parent=d)
                    return
            res["url"], res["play"] = u, play
            d.destroy()

        b = ttk.Frame(d)
        b.pack(fill="x", padx=10, pady=10)
        ttk.Button(b, text=T("▶ Reproducir", "▶ Play"), command=lambda: ok(True)).pack(side="right")
        ttk.Button(b, text=T("Analizar", "Analyze"), command=ok).pack(side="right", padx=6)
        ttk.Button(b, text=T("Cancelar", "Cancel"), command=d.destroy).pack(side="right")
        e.bind("<Return>", lambda ev: ok(True))
        d.bind("<Escape>", lambda ev: d.destroy())
        d.wait_window()
        if res.get("url"):
            self.path.set(res["url"])
            if res["play"]:
                self.analyzed_url = res["url"]  # vr-play detects it again while starting
                self.play()
            else:
                self.analyze_url(res["url"])

    def child_env(self):
        """DeoVR session for vr-play (environment, never on the command line)"""
        env = dict(os.environ)
        if self.deovr.get("login") and self.deovr.get("password"):
            env["VR_DEOVR_LOGIN"] = self.deovr["login"]
            env["VR_DEOVR_PASSWORD"] = self.deovr["password"]
        return env

    def deovr_flag(self, url):
        """links of the DeoVR-compatible site chosen in the DeoVR window are read with the DeoVR API"""
        site = url_host(self.cfg.get("deovr_site", "https://deovr.com"))
        h = url_host(url)
        return ["--deovr"] if h and site and (h == site or h.endswith("." + site)) else []

    def analyze_url(self, url):
        """what is this link? (title, size, 3D layout, VR) - vr-play --probe in the background"""
        self.analyzed_url = url
        self.kind.config(text=T("Consultando el vídeo online…", "Looking up the online video…"))
        cmd = vrplay_cmd() + ["--probe", "--quality", self.quality_key()] + self.deovr_flag(url) + [url]
        env = self.child_env()

        def work():
            try:
                r = subprocess.run(cmd, capture_output=True, text=True, timeout=150, env=env)
                out = r.stdout.strip().splitlines()
                info = json.loads(out[-1]) if out else None
                err = (r.stderr.strip().splitlines() or [""])[-1] if not info else ""
            except (OSError, ValueError, subprocess.SubprocessError) as ex:
                info, err = None, str(ex)
            self.q.put(("probe", (url, info, err)))
        threading.Thread(target=work, daemon=True).start()

    def show_probe(self, url, info, err):
        if url != self.path.get().strip():
            return  # the user moved on
        if not info:
            self.kind.config(text=T("No se pudo leer el enlace: ", "Could not read the link: ") + (err or "?"))
            if "yt-dlp" in (err or ""):
                self.append(err + "\n")
            return
        what = FORMAT_NAMES.get(info.get("layout"), info.get("layout"))
        pr = info.get("projection") or "flat"
        if pr.startswith("fisheye"):
            pr = "fisheye " + (pr.split(":")[1] if ":" in pr else "180")
        if pr != "flat":
            what = "VR %s° · %s" % (pr, "3D " + what if info["layout"] != "mono" else "2D")
        elif info.get("layout") != "mono":
            what = "3D " + what
        size = "%dx%d" % (info.get("width") or 0, info.get("height") or 0) if info.get("width") else ""
        if info.get("resolution"):
            size = "%dp" % info["resolution"]
        txt = " · ".join(x for x in (info.get("title"), size, what) if x)
        if info.get("note"):
            txt += T("  (sin indicios de 3D: elige el formato si es 3D)", "  (no sign of 3D: choose the format if it is 3D)")
