HERE = os.path.dirname(os.path.realpath(__file__))
WINDOWS = os.name == "nt"
VIDEO_EXT = (".mkv", ".mp4", ".m4v", ".avi", ".mov", ".wmv", ".ts", ".m2ts", ".mts", ".webm", ".mpg", ".mpeg",
             ".flv", ".3gp", ".ogv", ".vob")


def log(msg):
    print("vr-play: " + msg, file=sys.stderr, flush=True)


def find_tool(name, local):
    p = shutil.which(name)
    if p:
        return p
    for c in local:
        if os.path.exists(c):
            return c
    return None


def vrvideo_path():
    exe = "vrvideo.exe" if WINDOWS else "vrvideo"
    return os.environ.get("VRVIDEO") or find_tool(exe, [os.path.join(HERE, "build", exe),
                                                        os.path.join(HERE, "build", "Release", exe),
                                                        os.path.join(HERE, exe)])


def vrbd_path():
    return find_tool("vr-bd", [os.path.join(HERE, "bluray", "vr-bd"), os.path.join(HERE, "vr-bd")])


# ---------------------------------------------------------------------------------------------
# OpenXR runtime
# ---------------------------------------------------------------------------------------------
def runtime_candidates(name):
    home = os.path.expanduser("~")
    if name == "wivrn":
        flat = "app/io.github.wivrn.wivrn/current/active/files/share/openxr/1/openxr_wivrn.json"
        return ["/usr/share/openxr/1/openxr_wivrn.json", "/usr/local/share/openxr/1/openxr_wivrn.json",
                os.path.join(home, ".local/share/flatpak", flat), os.path.join("/var/lib/flatpak", flat)]
    if name == "steamvr":
        if WINDOWS:
            return [r"C:\Program Files (x86)\Steam\steamapps\common\SteamVR\steamxr_win64.json"]
        return [os.path.join(home, d, "steamapps/common/SteamVR/steamxr_linux64.json")
                for d in (".steam/steam", ".local/share/Steam", ".steam/root",
                          ".var/app/com.valvesoftware.Steam/data/Steam")]
    return []


def resolve_runtime(rt):
    """XR_RUNTIME_JSON for --runtime (None = leave the system's active runtime)"""
    if not rt or rt == "auto":
        return None
    if rt.endswith(".json"):
        if not os.path.isfile(rt):
            raise SystemExit("No existe el runtime: " + rt)
        return rt
    for c in runtime_candidates(rt):
        if os.path.isfile(c):
            return c
    raise SystemExit("No encuentro el runtime OpenXR de %s (busque en: %s). Usa --runtime /ruta/al.json"
                     % (rt, ", ".join(runtime_candidates(rt))))


def active_runtime_name():
    for d in [os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "/etc/xdg"]:
        p = os.path.join(d, "openxr", "1", "active_runtime.json")
        if os.path.isfile(p):
            try:
                with open(p) as f:
                    r = json.load(f).get("runtime", {})
                return "%s (%s)" % (r.get("name", "?"), os.path.realpath(p))
            except (OSError, ValueError):
                return p
    return None


