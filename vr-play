#!/usr/bin/env python3
# vr-play - 3D video player for VR headsets (OpenXR: WiVRn, SteamVR...).
#
#   vr-play pelicula.mkv                   formato automatico (por nombre y tamano)
#   vr-play --full / --half pelicula.mkv   SBS completo / half SBS
#   vr-play --tab / --htab pelicula.mkv    arriba/abajo completo / half
#   vr-play --2d pelicula.mkv              video normal (2D) en la pantalla virtual
#   vr-play --180 / --360 video.mp4        video VR de 180 / 360 grados (con --full/--tab/--2d: 3D o 2D)
#   vr-play --flat video.mp4               no tratarlo como video VR aunque lo parezca
#   vr-play /ruta/BLURAY  o  disco.iso     Blu-ray 3D desencriptado (MVC), sin recodificar
#   vr-play /ruta/CARPETA                  todos los videos de la carpeta, en orden
#   vr-play "https://youtube.com/..."      videos online 3D o VR (YouTube y todo lo que admita yt-dlp)
#   --quality 4320|2160|1440|1080          calidad maxima de los videos online (por defecto 4320 = 8K)
#   --probe                                solo detectar el formato (JSON), sin reproducir
#   vr-play "https://deovr.com/..."        DeoVR y webs compatibles (enlace de video, JSON o deovr://)
#   --deovr-list [URL]                     catalogo DeoVR en JSON (por defecto https://deovr.com/deovr)
#   --deovr-login USUARIO                  iniciar sesion (contrasena: VR_DEOVR_PASSWORD, llavero o se pregunta)
#   --deovr                                tratar el enlace como una web compatible con DeoVR
#   --deovr-dump URL                       mostrar el JSON que devuelve la web (para diagnosticar)
#   --swap                                 invertir ojos
#   --sub FICHERO.srt / --sub-track N      subtitulos de texto, dentro de cada ojo
#   --runtime auto|wivrn|steamvr|FICHERO.json   runtime OpenXR (por defecto el activo del sistema)
#   --screen M  --distance M               tamano y distancia de la pantalla virtual (metros)
#   --mode quad|render                     quad = capas por ojo (mejor); render = alternativo
#   --alang=spa,eng                        idioma del audio del Blu-ray
#   Cualquier otra --opcion va a mpv (--start=00:10:00, --aid=2, --volume=80...) o a vrvideo (--vr-*).
#
